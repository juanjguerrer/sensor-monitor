{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "juanjguerrer",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "codegen": "graphql-codegen",
    "dev": "ts-node-dev src/index.ts",
    "simulate": "ts-node src/scripts/simulate.ts",
    "simulate:live": "ts-node src/scripts/simulate.ts --live",
    "migrate": "node-pg-migrate -m src/migrations --envPath .env",
    "migrate:up": "node-pg-migrate up -m src/migrations --envPath .env",
    "migrate:down": "node-pg-migrate down -m src/migrations --envPath .env",
    "migrate:create": "node-pg-migrate create -m src/migrations --envPath .env",
    "build": "tsc"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "bcrypt": "^6.0.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.4.2",
    "node-pg-migrate": "^9.0.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
